# =============================================================================
# Aurora Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# 
# QUICK START (local development):
#   make init  # Auto-generates secrets
#   Add OPENROUTER_API_KEY (get from https://openrouter.ai/keys)
#   make prod-prebuilt   # or: make prod-local to build from source
# =============================================================================

# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
AURORA_ENV=dev

# Frontend dev server (make dev only; prod-local ignores this)
# bun  - Bun process + Turbopack (default)
# node - Node process + Webpack (use if frontend dev OOMs in Docker Desktop)
FRONTEND_DEV_RUNTIME=bun

# -----------------------------------------------------------------------------
# Database [REQUIRED]
# -----------------------------------------------------------------------------
POSTGRES_USER=aurora
POSTGRES_PASSWORD=
POSTGRES_DB=aurora_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_MIN=2
DB_POOL_MAX=20
# Seconds a starting server waits for the migration lock before failing
DB_MIGRATION_LOCK_TIMEOUT=240

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=32
CELERY_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Object Storage (S3-compatible)
# -----------------------------------------------------------------------------
# Default: SeaweedFS (included in docker-compose)
# Production: AWS S3, Cloudflare R2, MinIO, etc.
STORAGE_BUCKET=aurora-storage
STORAGE_ENDPOINT_URL=http://seaweedfs-filer:8333
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=admin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_VERIFY_SSL=false
STORAGE_CACHE_ENABLED=true
STORAGE_CACHE_TTL=60

# -----------------------------------------------------------------------------
# URLs & Networking
# -----------------------------------------------------------------------------
# These NEXT_PUBLIC_* vars are injected at container startup (not baked at build).
# Change them in .env and recreate the frontend container to take effect:
#   docker compose -f docker-compose.prod-local.yml up -d frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://aurora-server:5080
NEXT_PUBLIC_BACKEND_URL=http://localhost:5080
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:5006
CHATBOT_INTERNAL_URL=http://chatbot:5007

# -----------------------------------------------------------------------------
# Authentication & Security [REQUIRED]
# -----------------------------------------------------------------------------
# Auto-generated by: make init
FLASK_SECRET_KEY=
FLASK_PORT=5080
AUTH_SECRET=
# Leave blank to disable (not recommended in production).
INTERNAL_API_SECRET=

# Secrets backend: "vault" (default) or "aws_secrets_manager"
SECRETS_BACKEND=vault

# HashiCorp Vault (default backend)
VAULT_TOKEN=
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=aurora
VAULT_KV_BASE_PATH=users

# AWS Secrets Manager (only when SECRETS_BACKEND=aws_secrets_manager)
AWS_SM_REGION=
AWS_SM_PREFIX=aurora/users
# Dedicated credentials for Secrets Manager access. Keeps SM auth separate from
# the AWS connector's AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (used for cross-account
# STS AssumeRole). Falls back to the default boto3 credential chain if unset.
AWS_SM_ACCESS_KEY_ID=
AWS_SM_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# LLM & AI Services [REQUIRED]
# -----------------------------------------------------------------------------
# At least one API key required. OpenRouter recommended (supports multiple models).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Provider mode: "openrouter" (default, uses OpenRouter as proxy), "direct" (native APIs), "auto"
LLM_PROVIDER_MODE=openrouter
AGENT_RECURSION_LIMIT=240
# Full agent-graph restarts allowed per run after a genuine mid-stream transport
# error (HTTP/2 stream reset, incomplete chunked read, peer closed the socket).
# A restart re-runs — and re-bills — every previous turn, so throttling, 5xx and
# timeouts (already retried by the provider SDK) never trigger one. Default 1;
# 0 disables restarts.
AGENT_STREAM_RESTART_ATTEMPTS=1

# Background RCA cost knobs (interactive chat is unchanged by both):
# - RCA_CONTEXT_TOKEN_BUDGET: the safety net trims an investigation's message history at
#   this many tokens instead of 80% of the model window (~760K on a 1M model). Every
#   ReAct turn re-reads the whole history, so this bounds the per-turn input bill.
#   Default 200000. The budget counts the conversation messages only — the system
#   prompt and the tool definitions are sent on top of it. When the history outgrows
#   the budget the oldest tool turns are dropped down to 60% of it (the original alert
#   / task message is always kept) and that cut is reused until the budget is exceeded
#   again, so the prompt cache keeps hitting between cuts. On the cheap tier (Haiku
#   5.5) a request whose whole prompt exceeds 100K tokens bills 5x per token: to stay
#   on the base price tier the budget must leave room for the system prompt and tools
#   under that threshold, at the cost of a shorter memory.
# - RCA_TOOL_OUTPUT_PASS_THROUGH_CHARS: tool outputs longer than this are summarized
#   once by the cheap model before entering the loop (interactive chat uses 40000).
#   Default 20000 (~5K tokens).
# Empty, non-numeric or non-positive values mean the default.
RCA_CONTEXT_TOKEN_BUDGET=
RCA_TOOL_OUTPUT_PASS_THROUGH_CHARS=

# --- AI Safety Guardrails ---
# Three-layer defense: input rail for prompt injection on the user message, then
# signature matcher + LLM safety judge on every shell command. Judge and input
# rail fail closed on any error. Adapted from Meta's PurpleLlama (MIT licensed).
#
# Master switch (default: true). When true, all three layers run.
# Set to false to disable all guardrails.
# Configure the LLM model via GUARDRAILS_LLM_MODEL in the model overrides
# section below; when unset, defaults to google/gemini-2.5-flash-lite under
# LLM_PROVIDER_MODE=openrouter, otherwise to the cheap tier (anthropic/claude-haiku-5.5)
# when your provider settings can route it, else to MAIN_MODEL (see "Model overrides").
GUARDRAILS_ENABLED=true

# Gate the vendored SigmaHQ rule corpus inside the signature matcher
# (default: true). Requires GUARDRAILS_ENABLED=true. Set to false to
# run only hand-written rules.
GUARDRAILS_SIGMA_ENABLED=true

# Seconds a safety-judge verdict is remembered for the same (session, user message,
# command) — an investigation re-runs the same read commands many times. Keys hold
# only digests; errors and timeouts are never cached. Default 900; 0 disables.
COMMAND_SAFETY_VERDICT_TTL_SECONDS=900

# Slack live progress (default: true). While a background investigation runs,
# the "Thinking…" placeholder is edited every N seconds with elapsed time, the
# tool currently running and the agent's latest thought — clearly labelled as
# a progress note, not the answer. Interval minimum is 10s.
SLACK_PROGRESS_UPDATES_ENABLED=true
SLACK_PROGRESS_UPDATE_INTERVAL_SECONDS=30

# Web Search (SearXNG)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=

# AI Features
# Background RCA on the cheap tier (anthropic/claude-haiku-5.5, or MAIN_MODEL when the
# cheap tier is not routable — see "Model overrides") unless RCA_MODEL is set.
# Default true; unset or empty also means true. Set to false to run RCA on MAIN_MODEL's
# default (anthropic/claude-opus-5.5) at roughly 40x the per-token price.
RCA_OPTIMIZE_COSTS=true
GEMINI_DISABLE_THINKING=

# Embedding model for alert correlation (optional).
# Improves alert-to-incident grouping with semantic similarity.
# Requires a DIRECT API key — OpenRouter does NOT support embeddings.
# If left empty, uses Jaccard token similarity (works fine for most cases).
# Format: provider/model-name
# Examples:
#   openai/text-embedding-3-small  (requires OPENAI_API_KEY)
#   google/gemini-embedding-2      (requires GOOGLE_AI_API_KEY)
#   bedrock/amazon.titan-embed-text-v2:0  (uses the same region and credential chain as the
#     Bedrock chat provider: BEDROCK_REGION / AWS_REGION and an IAM role — static
#     BEDROCK_ACCESS_KEY_ID / BEDROCK_SECRET_ACCESS_KEY are optional. Titan Text Embeddings
#     V2 is served under its base in-region id only; there is no eu./us. profile for it.)
# Embeddings are cached per process (by text), so each alert is embedded once per
# correlation run and incident titles once across runs.
EMBEDDING_MODEL=

# Multi-agent RCA orchestrator (opt-in). When false (default), background RCA
# uses the legacy single-agent ReAct loop with RCA_MODEL. When true, a lead
# orchestrator triages each RCA and may fan out parallel read-only sub-agents.
ORCHESTRATOR_ENABLED=false

# Infrastructure visualization feature. When false (default), Aurora skips the
# periodic (~30s) and final LLM extraction that powers the incident infrastructure
# graph, saving cost. Set to true to re-enable the feature.
VISUALIZATION_ENABLED=false

# Frontend counterpart to VISUALIZATION_ENABLED: gates the visualization toggle and
# panel in the incident UI. Keep in sync with VISUALIZATION_ENABLED (off by default).
NEXT_PUBLIC_ENABLE_VISUALIZATION=false

# Opt-in org paywall (free/enterprise seat gating). Off by default — plain OSS
# deployments never paywall. When "true", free-tier orgs see an upgrade prompt
# instead of the Add-member flow. Actual seat enforcement is separate and only
# runs when a deployment activates the before_add_member hook (AURORA_HOOKS_MODULE).
NEXT_PUBLIC_ENABLE_PAYWALL=false

# Optional: Token budget for auto-loaded integration skills during background RCA.
# Defaults to 12000. Set higher to include more integration context, lower to save tokens.
RCA_SKILLS_TOKEN_BUDGET=
RCA_TOKEN_BUDGET=

# Model overrides — defaults vary by setting; see each variable below.
# Use provider/model format (e.g., openai/gpt-4.1, google/gemini-2.5-pro, ollama/llama3.1).
# Two tiers: MAIN_MODEL (interactive chat) defaults to anthropic/claude-opus-5.5; every
# background / classifier call below defaults to the cheap tier, anthropic/claude-haiku-5.5
# (1M context, adaptive thinking that Aurora switches off for classifier calls).
# The cheap tier is only the default when your provider settings can route a Claude
# model: LLM_PROVIDER_MODE=openrouter, anthropic or bedrock, or ANTHROPIC_API_KEY set
# under direct routing. Otherwise every "cheap tier" variable below falls back to
# MAIN_MODEL, so an OpenAI / Google / Vertex / Ollama-only install, or a Bedrock gateway
# pinned to bedrock/<id> values, keeps working without setting each one by hand (the
# safety judge and input rail fail closed, so they must always get a routable model).
# With MAIN_MODEL pinned to an explicit bedrock/<id>, the cheap tier stays on that Bedrock
# route in every LLM_PROVIDER_MODE: bedrock/<geo>.anthropic.claude-haiku-5-5 on the same
# geo in native mode (us/eu/au/jp/global — the geos AWS publishes Haiku 5.5 for), otherwise
# (gateway mode, apac., non-Claude pins) MAIN_MODEL itself. It never moves to another
# provider, so a stray ANTHROPIC_API_KEY cannot pull background traffic off Bedrock.
# Under LLM_PROVIDER_MODE=bedrock in an ap-* region with clean ids the cheap tier is not
# derived either (no apac. profile exists for Haiku 5.5) and the variables follow MAIN_MODEL.
# Empty values mean "use the default" for every variable in this section.

# Main model for chat and agent workflows. Defaults to anthropic/claude-opus-5.5.
MAIN_MODEL=

# RCA model for background root-cause analysis.
# Defaults to anthropic/claude-haiku-5.5 when RCA_OPTIMIZE_COSTS=true (the default), else anthropic/claude-opus-5.5
RCA_MODEL=

# Model for the Jira automatic-RCA yes/no judge. Defaults to the cheap tier (anthropic/claude-haiku-5.5).
JIRA_RCA_JUDGE_MODEL=

# * Only when ORCHESTRATOR_ENABLED=true — brain model for triage + synthesis.
RCA_ORCHESTRATOR_MODEL=

# * Only when ORCHESTRATOR_ENABLED=true — sub-agent investigator model.
RCA_SUBAGENT_MODEL=

# Vision model for multimodal tasks. Defaults to MAIN_MODEL if not set.
VISION_MODEL=

# Summarization model for incident reports, initial alert summaries, synopses and
# repo/channel metadata. Defaults to the cheap tier (anthropic/claude-haiku-5.5).
SUMMARIZATION_MODEL=

# Model that compresses oversized tool outputs during an investigation. Defaults to
# SUMMARIZATION_MODEL, then to the cheap tier.
TOOL_OUTPUT_SUMMARIZATION_MODEL=

# Enrichment model for Next Steps suggestion descriptions/summaries. Defaults to the
# cheap tier (anthropic/claude-haiku-5.5) — light polishing work, a small fast model is fine.
ENRICHMENT_MODEL=

# Suggestion extraction (hypotheses, diagnostics plan, recommendations). Defaults to the cheap tier.
SUGGESTION_MODEL=

# RCA summary / email report generation. Defaults to the cheap tier.
EMAIL_REPORT_MODEL=

# Infrastructure visualization extraction (only when VISUALIZATION_ENABLED=true). Defaults to the cheap tier.
VISUALIZATION_MODEL=

# One-word severity classification after a background RCA. Defaults to the cheap tier.
SEVERITY_MODEL=

# Memory extraction agent that runs after each investigation. Defaults to the cheap tier.
MEMORY_AGENT_MODEL=

# Per-message memory selector (one small call per chat turn). Defaults to the cheap tier.
MEMORY_SELECTOR_MODEL=

# Output-token caps (max_tokens) per call type. Without a cap a runaway answer is
# billed up to the model's own maximum (128K on Claude 5.x). Empty = default.
#   JUDGE        command-safety judge, Jira RCA judge (JSON verdict)         default 400
#   SEVERITY     one-word severity classification                            default 32
#   SUMMARY      tool-output / alert / synopsis / metadata summaries         default 1500
#   REPORT       RCA summary, hypotheses, diagnostics plan, recommendations,
#                enrichment, visualization, PR-review verdict extraction     default 4000
#   AGENT        one agent turn (interactive, RCA, recurrence, sub-agents);
#                applied to Claude on Bedrock/Anthropic, thinking counts too  default 16000
#   MEMORY_AGENT one turn of the memory extraction agent                     default 2000
LLM_MAX_TOKENS_JUDGE=
LLM_MAX_TOKENS_SEVERITY=
LLM_MAX_TOKENS_SUMMARY=
LLM_MAX_TOKENS_REPORT=
LLM_MAX_TOKENS_AGENT=
LLM_MAX_TOKENS_MEMORY_AGENT=

# Root-cause recurrence detection (dedup layer 1): off | shadow | live.
# live (default): verdicts fold (incidents.recurrence_of_incident_id) and the
#   rule correlator becomes hint-only — every alert gets a full investigation
#   before being grouped, which raises LLM spend in alert storms.
# shadow: after every completed investigation an agent judges whether the
#   incident is a recurrence and records a verdict row (recurrence_verdicts);
#   NOTHING folds and the rule correlator keeps attaching alerts as today.
# off: nothing runs — zero cost, legacy attach-only behavior.
# Cost note: shadow and live add one bounded agent run (a few LLM calls) per
# completed investigation.
RECURRENCE_DETECTION_MODE=live

# Wall-clock budget (seconds) for one recurrence check. Must stay well under
# the summarization task's soft time limit (330s) minus summary work.
RECURRENCE_AGENT_TIMEOUT_SECONDS=120

# Model for the recurrence agent. Defaults to the cheap tier (anthropic/claude-haiku-5.5).
RECURRENCE_AGENT_MODEL=

# Safety judge model for the AI guardrails layer (only used when GUARDRAILS_ENABLED=true).
# When unset, defaults to google/gemini-2.5-flash-lite under LLM_PROVIDER_MODE=openrouter,
# otherwise to the cheap tier (anthropic/claude-haiku-5.5) when routable, else MAIN_MODEL.
# A small, fast model is recommended since it runs on every command execution. Same
# provider/model format as MAIN_MODEL.
#
# IMPORTANT: Choose a non-reasoning model, or one whose thinking can be switched off
# (Aurora disables extended thinking on Claude models that allow it). The safety judge is a
# binary Yes/No classifier; reasoning/thinking models (e.g. gpt-5.4-mini, gemini-2.5-pro,
# o3-mini) waste their output token budget on chain-of-thought, adding seconds of latency and
# cost for no classification benefit. Good choices: claude-haiku-5.5, gpt-4o-mini,
# gemini-2.5-flash-lite.
GUARDRAILS_LLM_MODEL=

# Vertex AI (Google Cloud) - set VERTEX_AI_PROJECT + one auth method
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=global
VERTEX_AI_SERVICE_ACCOUNT_JSON=

# Ollama (local LLM inference) - install Ollama on host, pull models with `ollama pull <model>`
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AWS Bedrock — two modes, auto-selected from config:
#  - Native mode (recommended): leave BEDROCK_BASE_URL unset and set BEDROCK_REGION
#    (falls back to AWS_REGION/AWS_DEFAULT_REGION), e.g. BEDROCK_REGION=eu-central-1.
#    Credentials: prefer an IAM role (EC2 instance profile / ECS task role / EKS IRSA) —
#    boto3's default chain picks it up with no keys in this file. Static
#    BEDROCK_ACCESS_KEY_ID / BEDROCK_SECRET_ACCESS_KEY are the fallback. BEDROCK_PROFILE
#    (named ~/.aws profile) only works if ~/.aws is mounted into the server, chatbot and
#    celery containers — Compose and the Helm chart do not do that out of the box.
#  - Gateway mode (deprecated upstream): set BEDROCK_BASE_URL to an OpenAI-compatible
#    endpoint (e.g. an AWS Bedrock Access Gateway inside your VPC exposing
#    .../v1/chat/completions). BEDROCK_API_KEY is optional (the VPC boundary handles auth).
# Recommended routing: LLM_PROVIDER_MODE=bedrock — every Claude pick (MAIN_MODEL, RCA_MODEL,
# the cheap tier anthropic/claude-haiku-5.5, ...) is translated to the matching
# inference-profile id for the region (eu.anthropic.claude-haiku-5-5 on an EU region).
# A model Bedrock cannot serve (openai/, google/, vertex/) falls back to its own provider
# IF that provider has credentials configured — leave the other provider keys empty to
# keep every call on Bedrock.
# Alternative: LLM_PROVIDER_MODE=direct and point the model variables at explicit
# bedrock/<id> values. Gateway <id> = the model name the gateway expects; native <id> =
# a Bedrock inference-profile id, e.g. bedrock/eu.anthropic.claude-haiku-5-5 or
# bedrock/eu.anthropic.claude-opus-5-5 (the Claude 5.x generation has no date suffix).
# With MAIN_MODEL pinned that way, the unset cheap-tier variables stay on the same
# Bedrock geo (bedrock/eu.anthropic.claude-haiku-5-5 for an eu. pin; MAIN_MODEL for a
# gateway name) — see "Model overrides".
# BEDROCK_REGION=global selects Bedrock's global. inference profiles, which bill at the
# direct list price instead of the ~10% cross-region (geo CRIS) premium. boto3 is still
# signed against AWS_REGION/AWS_DEFAULT_REGION (default us-east-1) in that case.
# DATA RESIDENCY WARNING: global. profiles may process requests in any commercial AWS
# Region worldwide. Do not use them for EU/GDPR-bound deployments — keep an EU region
# (eu.* geo profiles stay inside the EU).
# Native-mode client tuning (botocore): "standard" retries with exponential backoff on
# throttling / 5xx / connection errors, capped at BEDROCK_MAX_ATTEMPTS total attempts
# (default 3), a 10 s connect timeout and a BEDROCK_READ_TIMEOUT read timeout (default
# 300 s — long enough for a streaming agent turn with thinking; small classifier calls
# shrink it per call). Gateway mode retries twice through the OpenAI client.
# Cost tracking: Bedrock geo inference profiles (us./eu./apac.) bill above the Anthropic
# list price Aurora's static table carries; llm_usage_tracking rows served by Bedrock are
# multiplied by BEDROCK_REGIONAL_PREMIUM (default 1.10, AWS's published ~10%; 1.0
# disables it). Bedrock's own Anthropic price table could not be read automatically, so
# calibrate this against Cost Explorer. global. profiles never carry the premium.
BEDROCK_BASE_URL=
BEDROCK_API_KEY=
BEDROCK_REGION=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_SESSION_TOKEN=
BEDROCK_PROFILE=
BEDROCK_READ_TIMEOUT=
BEDROCK_MAX_ATTEMPTS=
BEDROCK_REGIONAL_PREMIUM=

# -----------------------------------------------------------------------------
# Cloud Provider Integrations (Optional)
# -----------------------------------------------------------------------------

# GCP
CLIENT_ID=
CLIENT_SECRET=

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Cloud Provider Cache (applies to all providers)
AURORA_SETUP_CACHE_ENABLED=true
AURORA_SETUP_CACHE_TTL=3600
AURORA_VERIFY_CLI_IDENTITY=false
AURORA_CACHE_TOKEN_IN_REDIS=false

# -----------------------------------------------------------------------------
# Third-Party Integrations (Optional)
# -----------------------------------------------------------------------------

# GitHub auth mode: app | oauth | hybrid (default: app)
#   app    — GitHub App only (recommended, the only path most deployments need)
#   oauth  — Legacy user OAuth only. For on-prem deployments that cannot host
#            their own GitHub App. Requires GH_OAUTH_CLIENT_ID/SECRET below.
#   hybrid — Both paths active. Frontend dialog shows both CTAs; auth router
#            prefers App tokens and falls back to OAuth.
GITHUB_AUTH_MODE=app

# GitHub App. Setup guide: website/docs/integrations/connectors.md (GitHub section).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# WEBHOOK_URL/SETUP_URL are backend routes — use your API host (e.g. api.<domain>,
# or a tunnel to port 5080 in dev), not the frontend URL.
GITHUB_APP_WEBHOOK_URL=
GITHUB_APP_SETUP_URL=
# Fallback used when the value is not stored in Vault.
GITHUB_APP_WEBHOOK_SECRET=
# Enable/disable Incident Prevention (PR change-gating reviews). Set to false to turn off.
NEXT_PUBLIC_ENABLE_INCIDENT_PREVENTION=true

# One-click website signup (hosted deployments only — leave off for self-hosted).
# Requires the App setting "Request user authorization (OAuth) during installation"
# and <API_URL>/github/app/signup/callback registered as the App's FIRST Callback URL.
GITHUB_APP_CLIENT_SECRET=
HOSTED_SIGNUP_ENABLED=false

# SAML SSO: require orgs to prove email-domain ownership with a DNS TXT record
# before SSO routes that domain to them. Off by default for self-hosted installs;
# set true on any deployment where orgs don't trust each other (e.g. SaaS, or an
# internet-facing instance with open sign-up).
SSO_ENFORCE_DOMAIN_VERIFICATION=false

# GitHub OAuth (only required when GITHUB_AUTH_MODE=oauth or =hybrid).
# Create at https://github.com/settings/developers > New OAuth App.
# Authorization callback URL must be: <NEXT_PUBLIC_BACKEND_URL>/github/callback
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Microsoft Teams — see server/connectors/teams_connector/README.md
TEAMS_CLIENT_ID= # Entra → App registration → Overview → Application (client) ID
TEAMS_CLIENT_SECRET= # Entra → Certificates & secrets → client secret Value (copy when created; also Bot Framework app password)
# REQUIRED for Connect — if blank, Connect tells the user a developer must finish the setup.
# OAuth sign-in endpoint for Connect (must match app registration account types):
#   <tenant GUID> — single-tenant app (typical self-hosted): Entra → Overview → Tenant ID
#   common — multitenant app only (single-tenant apps cannot use /common)
#   organizations — multitenant, work/school accounts only
TEAMS_TENANT_ID=
TEAMS_APP_ID= # optional — only when the bot’s Microsoft App ID differs from TEAMS_CLIENT_ID (split Entra apps). Leave unset for one-app setup.


# Socket Mode (private/self-hosted, no public webhook URL): app-level token
# (xapp-...) with connections:write. Set it + enable Socket Mode in Slack to use
# an outbound WebSocket instead of HTTP webhooks. Empty = HTTP Events API.
SLACK_APP_TOKEN=

# Google Chat (OAuth for setup, service account for messaging)
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
GOOGLE_CHAT_SERVICE_ACCOUNT_KEY=

# PagerDuty
NEXT_PUBLIC_ENABLE_PAGERDUTY_OAUTH=false
PAGERDUTY_CLIENT_ID=
PAGERDUTY_CLIENT_SECRET=

# Bitbucket
NEXT_PUBLIC_ENABLE_BITBUCKET_OAUTH=false
BB_OAUTH_CLIENT_ID=
BB_OAUTH_CLIENT_SECRET=

# OVH (multiple regions)
NEXT_PUBLIC_ENABLE_OVH=false

# Atlassian OAuth (shared by Confluence + Jira)
# One OAuth app covers both products. Create at:
#   https://developer.atlassian.com/console/myapps/
# 1. Create > OAuth 2.0 integration > Name: "Aurora"
# 2. Permissions: add Confluence API scopes and/or Jira platform REST API scopes
# 3. Authorization > Callback URL: http://localhost:3000/atlassian/callback
# 4. Settings > copy Client ID and Secret below
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# SharePoint
NEXT_PUBLIC_ENABLE_SHAREPOINT=false
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_TENANT_ID=common

# Notion (OAuth is optional — integration-token flow works without NOTION_CLIENT_* values)
NEXT_PUBLIC_ENABLE_NOTION=false
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Spinnaker
NEXT_PUBLIC_ENABLE_SPINNAKER=false

OVH_EU_CLIENT_ID=
OVH_EU_CLIENT_SECRET=
OVH_CA_CLIENT_ID=
OVH_CA_CLIENT_SECRET=
OVH_US_CLIENT_ID=
OVH_US_CLIENT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aurora

# -----------------------------------------------------------------------------
# Kubernetes & Pod Isolation
# -----------------------------------------------------------------------------
ENABLE_POD_ISOLATION=false
TERMINAL_NAMESPACE=
TERMINAL_IMAGE=
TERMINAL_POD_TTL=
TERMINAL_RUNTIME_CLASS=
CHATBOT_POD_TTL=
USE_UNTRUSTED_NODES=
NEXT_PUBLIC_KUBECTL_AGENT_CHART_URL=

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# SSL/TLS for External Services
# -----------------------------------------------------------------------------
# PostgreSQL: "prefer" auto-negotiates TLS (works for RDS/Cloud SQL out of box)
# Set to "require" to enforce, "verify-ca"/"verify-full" with POSTGRES_SSLROOTCERT
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

# Redis: use rediss:// URL scheme to enable TLS (e.g., REDIS_URL=rediss://host:6380/0)
REDIS_SSL_CA_CERTS=
REDIS_SSL_CERT_REQS=

# -----------------------------------------------------------------------------
# Memgraph (Graph Database)
# -----------------------------------------------------------------------------
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_SCHEME=bolt              # Use "bolt+ssc" for Memgraph Cloud
MEMGRAPH_USER=                    # Optional: only needed for hosted/auth-enabled Memgraph
MEMGRAPH_PASSWORD=                # Optional: only needed for hosted/auth-enabled Memgraph
DISCOVERY_INTERVAL_HOURS=1

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMITING_ENABLED=false
RATE_LIMIT_BYPASS_TOKEN=
RATE_LIMIT_HEADERS_ENABLED=true

# -----------------------------------------------------------------------------
# Splunk SSL Verification
# Accepts: "false" (default), "true", or a path to a private CA bundle (e.g. /etc/ssl/certs/splunk-ca.pem)
# -----------------------------------------------------------------------------
SPLUNK_SSL_VERIFY=false
# Elastic: true (default), false, or path to a CA bundle for self-managed clusters
ELASTIC_SSL_VERIFY=true

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------
MCP_PORT=8811

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
NGROK_URL=

# Show the initial user RCA message (the auto-generated prompt) in the chat UI.
DISPLAY__RCA_USER_MSG=false

# Extensibility hooks — optional, set to a Python module path to load custom hook implementations
AURORA_HOOKS_MODULE=

# CloudBees CI connector (feature-flagged)
NEXT_PUBLIC_ENABLE_CLOUDBEES=false

# -----------------------------------------------------------------------------
# Custom MCP servers (connector)
# -----------------------------------------------------------------------------
# Allow MCP URLs on private/loopback addresses. Default true (Compose, Helm,
# unset env). Set false on multi-tenant SaaS deployments.
MCP_ALLOW_PRIVATE_TARGETS=true
