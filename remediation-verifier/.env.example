# Optional environment for the remediation verifier.
#
# Nothing here is required: SNAPSHOT mode needs no configuration and no
# cluster. Copy this file to `.env` (which is gitignored) and load it with:
#
#     set -a; . ./.env; set +a
#
# Never commit `.env`. Never put tokens or kubeconfigs in either file.

# Where the pinned aurora-lab checkout lives. `make doctor` reports its commit.
# Default: ../aurora-lab relative to the aurora fork (i.e. the sibling repo).
RV_LAB_DIR=
